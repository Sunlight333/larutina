// LaRutina platform schema. Phase 1 starts with the catalog of template v1.1
// (docs: 03-data-model §1.1, A3 import contract). Conventions: opaque ids;
// business codes (code, sku) unique and never reused; money as integer
// centavos; timestamps in UTC; snake_case tables and columns; soft delete
// (deleted_at) for admin-managed entities.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- lists ----

enum ProductStatus {
  DRAFT // Borrador
  ACTIVE // Activo
  PRESALE // Preventa
  SOLD_OUT // Agotado
  ARCHIVED // Archivado
}

enum Aptitude {
  IDEAL
  SUITABLE // Apto
  CAUTION // Con precaución
  NOT_RECOMMENDED // No recomendado
}

enum Moment {
  AM
  PM
  BOTH // AM y PM
}

enum RoutineStepType {
  MAKEUP_REMOVER // Desmaquillante
  CLEANSER // Limpiador
  EXFOLIANT // Exfoliante
  TONER // Tónico
  ESSENCE // Esencia
  SERUM // Sérum
  EYE_CONTOUR // Contorno de ojos
  MOISTURIZER // Hidratante
  OIL // Aceite
  SUNSCREEN // Protector solar
  MASK // Mascarilla
  TREATMENT // Tratamiento
}

enum Unit {
  ML
  G
  UNITS // unidades
}

enum ConflictSeverity {
  AVOID // Evitar
  CAUTION // Con precaución
  ALTERNATE_DAYS // Días alternos
}

enum RoutineDifficulty {
  BASIC // Básica
  INTERMEDIATE // Intermedia
  COMPLETE // Completa
}

enum ExperienceLevel {
  BASIC // Básico
  INTERMEDIATE // Intermedio
  ADVANCED // Avanzado
}

enum ProductType {
  PRODUCT // Producto: the only type the engine and routines use
  KIT
  TRAVEL_SIZE // Tamaño de viaje
}

enum SealValue {
  YES
  NO
  UNKNOWN // Sin dato: never shown, never in a filter
}

enum ProductLabel {
  NEW // Nuevo
  LIMITED_EDITION // Edición limitada
  DERMATOLOGIST_RECOMMENDED // Recomendado por dermatóloga
}

enum ProductRelationKind {
  COMPATIBLE
  COMPLEMENTARY
  ALTERNATIVE
}

enum IngredientStatus {
  ACTIVE
  REVIEW // created by an import from an INCI list: "nuevo · revisar"
}

enum RoutineStatus {
  DRAFT
  PUBLISHED
}

enum SynonymType {
  SKIN_TYPE // Tipo de piel
  CONCERN // Necesidad
  PRODUCT_TYPE // Tipo de producto
  BRAND // Marca
  INGREDIENT // Ingrediente
  INTENT // Intención
}

enum KnowledgeCategory {
  SHIPPING // Envíos
  PAYMENTS // Pagos
  RETURNS // Cambios y devoluciones
  PRODUCT_USE // Uso de productos
  ROUTINES // Rutinas
  AMBASSADORS // Embajadoras
  GENERAL
}

enum EndorsementTarget {
  PRODUCT
  ROUTINE
}

enum ImportStatus {
  REJECTED // validation found errors; nothing written
  VALIDATED // dry run without errors; nothing written
  APPLIED // written in one transaction
}

// ------------------------------------------------------------- taxonomy ----

model Brand {
  id              String    @id @default(cuid())
  code            String    @unique
  name            String
  countryOfOrigin String?   @map("country_of_origin")
  description     String?
  logoFile        String?   @map("logo_file")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  products        Product[]

  @@map("brands")
}

model Category {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  parentId    String?    @map("parent_id")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  sortOrder   Int?       @map("sort_order")
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")
  products    Product[]

  @@index([parentId])
  @@map("categories")
}

model Concern {
  id               String              @id @default(cuid())
  code             String              @unique
  name             String
  shortLabel       String              @map("short_label") // ≤ 18 characters
  shortDescription String?             @map("short_description")
  editorialContent String?             @map("editorial_content")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  deletedAt        DateTime?           @map("deleted_at")
  products         ProductConcern[]
  ingredients      IngredientConcern[]
  routines         RoutineConcern[]

  @@map("concerns")
}

model SkinType {
  id          String            @id @default(cuid())
  code        String            @unique // "sensible" acts as a modifier in the diagnosis
  name        String
  description String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")
  products    ProductSkinType[]
  routines    RoutineSkinType[]

  @@map("skin_types")
}

model IngredientFamily {
  id                    String           @id @default(cuid())
  code                  String           @unique
  name                  String
  warning               String? // added to the product's precautions
  excludableInDiagnosis Boolean          @default(false) @map("excludable_in_diagnosis")
  noDuplicate           Boolean          @default(false) @map("no_duplicate") // never two in one routine moment
  computes              String[] // informative: flags this family drives (sin_fragancia, …)
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  ingredients           Ingredient[]
  conflictsA            FamilyConflict[] @relation("FamilyA")
  conflictsB            FamilyConflict[] @relation("FamilyB")

  @@map("ingredient_families")
}

model Ingredient {
  id          String               @id @default(cuid())
  code        String               @unique
  commonName  String               @map("common_name")
  inciName    String               @map("inci_name")
  inciKey     String               @map("inci_key") // normalized INCI name, for matching INCI lists
  isKeyActive Boolean              @default(false) @map("is_key_active")
  isIrritant  Boolean              @default(false) @map("is_irritant")
  description String?
  familyId    String?              @map("family_id")
  family      IngredientFamily?    @relation(fields: [familyId], references: [id])
  status      IngredientStatus     @default(ACTIVE)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  deletedAt   DateTime?            @map("deleted_at")
  concerns    IngredientConcern[]
  products    ProductIngredient[]
  conflictsA  IngredientConflict[] @relation("IngredientA")
  conflictsB  IngredientConflict[] @relation("IngredientB")

  @@index([inciKey])
  @@index([familyId])
  @@map("ingredients")
}

model IngredientConcern {
  ingredientId String     @map("ingredient_id")
  concernId    String     @map("concern_id")
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  concern      Concern    @relation(fields: [concernId], references: [id], onDelete: Cascade)

  @@id([ingredientId, concernId])
  @@map("ingredient_concerns")
}

model IngredientConflict {
  id            String           @id @default(cuid())
  ingredientAId String           @map("ingredient_a_id")
  ingredientBId String           @map("ingredient_b_id")
  ingredientA   Ingredient       @relation("IngredientA", fields: [ingredientAId], references: [id], onDelete: Cascade)
  ingredientB   Ingredient       @relation("IngredientB", fields: [ingredientBId], references: [id], onDelete: Cascade)
  severity      ConflictSeverity
  note          String?

  @@unique([ingredientAId, ingredientBId])
  @@map("ingredient_conflicts")
}

model FamilyConflict {
  id        String           @id @default(cuid())
  familyAId String           @map("family_a_id")
  familyBId String           @map("family_b_id")
  familyA   IngredientFamily @relation("FamilyA", fields: [familyAId], references: [id], onDelete: Cascade)
  familyB   IngredientFamily @relation("FamilyB", fields: [familyBId], references: [id], onDelete: Cascade)
  severity  ConflictSeverity
  note      String?

  @@unique([familyAId, familyBId])
  @@map("family_conflicts")
}

// -------------------------------------------------------------- product ----

model Product {
  id                      String                   @id @default(cuid())
  code                    String                   @unique // also the URL slug
  name                    String
  brandId                 String                   @map("brand_id")
  brand                   Brand                    @relation(fields: [brandId], references: [id])
  categoryId              String                   @map("category_id")
  category                Category                 @relation(fields: [categoryId], references: [id])
  status                  ProductStatus            @default(DRAFT)
  type                    ProductType              @default(PRODUCT)
  shortDescription        String                   @map("short_description")
  description             String
  benefits                String[] // "VERBO: texto" items
  whyWeChose              String                   @map("why_we_chose")
  evaluationScore         Int?                     @map("evaluation_score") // 0–100; not published until the method exists (D-10)
  evaluationNotes         String?                  @map("evaluation_notes")
  howToUse                String                   @map("how_to_use")
  precautions             String?
  texture                 String
  textureDescription      String?                  @map("texture_description")
  tips                    String?
  routineStep             RoutineStepType          @map("routine_step")
  moment                  Moment
  durationDays            Int?                     @map("duration_days")
  level                   ExperienceLevel?
  priority                Int? // 1 = first; engine tie-break and "Recomendados" order
  baseProductId           String?                  @map("base_product_id") // travel sizes inherit from it
  baseProduct             Product?                 @relation("TravelSize", fields: [baseProductId], references: [id])
  travelSizes             Product[]                @relation("TravelSize")
  kitContents             String[]                 @map("kit_contents") // SKUs a kit contains
  line                    String?
  headline                String? // ≤ 8 words
  chips                   String[] // ≤ 3, ≤ 20 characters each
  labels                  ProductLabel[]
  vegan                   SealValue                @default(UNKNOWN)
  crueltyFree             SealValue                @default(UNKNOWN) @map("cruelty_free")
  dermatologistTested     SealValue                @default(UNKNOWN) @map("dermatologist_tested")
  sealSource              String?                  @map("seal_source") // internal, never published
  anmatRegistration       String?                  @map("anmat_registration")
  importerHolder          String?                  @map("importer_holder") // per product, as on the label (D-14)
  countryOfOrigin         String?                  @map("country_of_origin") // empty: the brand's
  paoMonths               Int?                     @map("pao_months")
  vatRate                 Decimal?                 @map("vat_rate") @db.Decimal(5, 2) // only when not the general rate
  inciText                String?                  @map("inci_text")
  images                  String[] // file names; the first is the main image
  videoUrl                String?                  @map("video_url")
  seoTitle                String?                  @map("seo_title")
  seoDescription          String?                  @map("seo_description")
  presaleDate             DateTime?                @map("presale_date") @db.Date // Preventa: arrival date shown on the site (NAV-08)
  manualOrder             Int?                     @map("manual_order") // "Recomendados": priority first, then this
  publishedAt             DateTime?                @map("published_at") // first time it left draft: "Novedades" and the "Nuevo" label
  // Pending panel edits of a published product (ADM-02): the site shows the
  // columns; preview overlays this; "Publicar" applies it to the columns.
  draft                   Json?
  // Computed from the ingredients' families on every import or edit (CAT-08).
  fragranceFree           Boolean                  @default(true) @map("fragrance_free")
  fragranceFreeDeclared   Boolean?                 @map("fragrance_free_declared") // the loaded value, kept as a check
  essentialOilFree        Boolean                  @default(true) @map("essential_oil_free")
  containsRetinoid        Boolean                  @default(false) @map("contains_retinoid")
  containsExfoliatingAcid Boolean                  @default(false) @map("contains_exfoliating_acid")
  alcoholFree             Boolean                  @default(true) @map("alcohol_free")
  parabenFree             Boolean                  @default(true) @map("paraben_free")
  siliconeFree            Boolean                  @default(true) @map("silicone_free")
  sulfateFree             Boolean                  @default(true) @map("sulfate_free")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  deletedAt               DateTime?                @map("deleted_at")
  variants                ProductVariant[]
  ingredients             ProductIngredient[]
  concerns                ProductConcern[]
  skinTypes               ProductSkinType[]
  relations               ProductRelation[]        @relation("RelationFrom")
  relatedFrom             ProductRelation[]        @relation("RelationTo")
  evaluations             ProductEvaluation[]
  routineSteps            RoutineStep[]
  routineAlternatives     RoutineStepAlternative[]
  favorites               Favorite[]
  reviews                 Review[]

  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id              String   @id @default(cuid())
  sku             String   @unique
  productId       String   @map("product_id")
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size            Decimal  @db.Decimal(10, 2)
  unit            Unit
  priceCents      Int      @map("price_cents")
  promoPriceCents Int?     @map("promo_price_cents") // always below price
  stock           Int
  barcode         String?
  weightGrams     Int?     @map("weight_grams")
  isMain          Boolean  @default(false) @map("is_main") // exactly one per product
  durationDays    Int?     @map("duration_days")
  heightCm        Decimal? @map("height_cm") @db.Decimal(6, 1)
  widthCm         Decimal? @map("width_cm") @db.Decimal(6, 1)
  lengthCm        Decimal? @map("length_cm") @db.Decimal(6, 1)
  costCents       Int?     @map("cost_cents") // admin role only (CAT-20)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  cartItems    CartItem[]
  orderItems   OrderItem[]
  reservations StockReservation[]
  movements    InventoryMovement[]
  backInStock  BackInStockRequest[]

  @@index([productId])
  @@map("product_variants")
}

model ProductIngredient {
  productId     String     @map("product_id")
  ingredientId  String     @map("ingredient_id")
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id])
  inciOrder     Int        @map("inci_order") // 1-based position in the INCI list
  isStar        Boolean    @default(false) @map("is_star") // highlighted in this product
  concentration String?

  @@id([productId, ingredientId])
  @@index([ingredientId])
  @@map("product_ingredients")
}

model ProductConcern {
  productId String  @map("product_id")
  concernId String  @map("concern_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  concern   Concern @relation(fields: [concernId], references: [id])
  relevance Int // 0–100

  @@id([productId, concernId])
  @@index([concernId, relevance])
  @@map("product_concerns")
}

model ProductSkinType {
  productId  String   @map("product_id")
  skinTypeId String   @map("skin_type_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  skinType   SkinType @relation(fields: [skinTypeId], references: [id])
  aptitude   Aptitude

  @@id([productId, skinTypeId])
  @@index([skinTypeId])
  @@map("product_skin_types")
}

model ProductRelation {
  productId String              @map("product_id")
  relatedId String              @map("related_id")
  kind      ProductRelationKind
  position  Int
  product   Product             @relation("RelationFrom", fields: [productId], references: [id], onDelete: Cascade)
  related   Product             @relation("RelationTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@id([productId, relatedId, kind])
  @@map("product_relations")
}

model EvaluationCriterion {
  id          String              @id @default(cuid())
  code        String              @unique
  name        String
  weight      Decimal             @db.Decimal(8, 2) // normalized when computing the total
  description String?
  evaluations ProductEvaluation[]

  @@map("evaluation_criteria")
}

model ProductEvaluation {
  productId   String              @map("product_id")
  criterionId String              @map("criterion_id")
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  criterion   EvaluationCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  score       Int // 0–100
  note        String?

  @@id([productId, criterionId])
  @@map("product_evaluations")
}

// Table only in the MVP; the product page hides the block until Fase 2 (CAT-21).
model Endorsement {
  id         String            @id @default(cuid())
  targetType EndorsementTarget @map("target_type")
  targetCode String            @map("target_code") // product or routine code
  entity     String
  detail     String?
  quote      String?
  image      String?
  active     Boolean           @default(false)
  createdAt  DateTime          @default(now()) @map("created_at")

  @@index([targetType, targetCode])
  @@map("endorsements")
}

// ------------------------------------------------------------- routines ----

model Routine {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String
  goal        String
  moment      Moment
  difficulty  RoutineDifficulty?
  discountPct Int?               @map("discount_pct")
  description String?
  status      RoutineStatus      @default(DRAFT)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")
  skinTypes   RoutineSkinType[]
  concerns    RoutineConcern[]
  steps       RoutineStep[]

  @@map("routines")
}

model RoutineSkinType {
  routineId  String   @map("routine_id")
  skinTypeId String   @map("skin_type_id")
  routine    Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  skinType   SkinType @relation(fields: [skinTypeId], references: [id])

  @@id([routineId, skinTypeId])
  @@map("routine_skin_types")
}

model RoutineConcern {
  routineId String  @map("routine_id")
  concernId String  @map("concern_id")
  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  concern   Concern @relation(fields: [concernId], references: [id])

  @@id([routineId, concernId])
  @@map("routine_concerns")
}

model RoutineStep {
  id            String                   @id @default(cuid())
  routineId     String                   @map("routine_id")
  routine       Routine                  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  position      Int
  moment        Moment
  stepType      RoutineStepType          @map("step_type")
  title         String
  mainProductId String                   @map("main_product_id")
  mainProduct   Product                  @relation(fields: [mainProductId], references: [id])
  instruction   String?
  frequency     String?
  optional      Boolean                  @default(false)
  alternatives  RoutineStepAlternative[]

  @@unique([routineId, position])
  @@map("routine_steps")
}

model RoutineStepAlternative {
  stepId    String      @map("step_id")
  productId String      @map("product_id")
  position  Int
  step      RoutineStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([stepId, productId])
  @@map("routine_step_alternatives")
}

// ---------------------------------------------------- search and assistant ----

model Synonym {
  id         String      @id @default(cuid())
  term       String
  type       SynonymType
  targetCode String      @map("target_code")
  variants   String[]

  @@unique([type, targetCode, term])
  @@map("synonyms")
}

model KnowledgeEntry {
  id        String            @id @default(cuid())
  code      String            @unique
  category  KnowledgeCategory
  question  String
  answer    String
  keywords  String[]
  active    Boolean           @default(true)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@map("knowledge_entries")
}

// --------------------------------------------------------------- import ----

model ImportJob {
  id        String       @id @default(cuid())
  fileName  String       @map("file_name")
  status    ImportStatus
  stage     String // S1 or S5: which fields are required
  summary   Json // counts created / updated per entity
  issues    Json // [{ sheet, row, field, level, message }]
  createdAt DateTime     @default(now()) @map("created_at")

  @@map("import_jobs")
}

// ---------------------------------------------------------------- admin ----

enum AdminRole {
  ADMIN // Administración: everything, including users, cost and margin
  CATALOG // Catálogo
  CONTENT // Contenido
  SUPPORT // Atención
  AMBASSADORS // Embajadoras
}

model AdminUser {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  role          AdminRole
  passwordHash  String         @map("password_hash")
  totpSecret    String?        @map("totp_secret") // base32; active once totpEnabledAt is set
  totpEnabledAt DateTime?      @map("totp_enabled_at")
  totpLastStep  Int?           @map("totp_last_step") // each code is accepted once
  active        Boolean        @default(true)
  failedLogins  Int            @default(0) @map("failed_logins")
  lockedUntil   DateTime?      @map("locked_until")
  lastLoginAt   DateTime?      @map("last_login_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  sessions      AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id         String    @id // SHA-256 of the cookie token; the token itself is never stored
  userId     String    @map("user_id")
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  mfaPassed  Boolean   @default(false) @map("mfa_passed")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  ip         String?
  userAgent  String?   @map("user_agent")

  @@index([userId])
  @@map("admin_sessions")
}

// Who changed what and when (ADM-03). Append-only.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  actorEmail String?  @map("actor_email")
  action     String // create, update, publish, delete, restore, import, login, ...
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  label      String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Panel-editable configuration (GEN-07, 03 §4). Keys and defaults live in
// src/server/settings/registry.ts; a row exists only once a value is changed.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("settings")
}

// -------------------------------------------------------------- content ----

enum PageKind {
  HOME
  LANDING
  INSTITUTIONAL // Nosotras, Cómo elegimos, ...
  HELP // Preguntas frecuentes, Envíos, ...
}

// Block-based pages (CMS-01). The panel edits `draft`; "Publicar" copies it to
// `published`, which is all the site reads (ADM-02).
model Page {
  id          String    @id @default(cuid())
  slug        String    @unique // "inicio" is the Home
  kind        PageKind
  title       String
  draft       Json // { seoTitle, seoDescription, blocks: [{ id, type, enabled, data }] }
  published   Json?
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("pages")
}

model ArticleCategory {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  position Int    @default(0)

  @@map("article_categories")
}

// Blog (CMS-02). Same draft and published split as pages.
model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String // the draft title, for the panel list
  draft       Json // { title, excerpt, body, coverImage, categorySlug, author, reviewedBy, productCodes, routineCodes, relatedSlugs, seoTitle, seoDescription }
  published   Json?
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("articles")
}

// Legal texts with every published version kept (CMS-04).
model LegalDocument {
  id        String         @id @default(cuid())
  code      String         @unique // terminos, privacidad, cambios-y-devoluciones, cookies, programa-embajadoras
  title     String
  draftBody String         @default("") @map("draft_body")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  versions  LegalVersion[]

  @@map("legal_documents")
}

model LegalVersion {
  id          String        @id @default(cuid())
  documentId  String        @map("document_id")
  document    LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  version     Int
  title       String
  body        String
  publishedAt DateTime      @default(now()) @map("published_at")
  publishedBy String?       @map("published_by")

  @@unique([documentId, version])
  @@map("legal_versions")
}

// Rotating announcement bar with validity dates (NAV-01).
model Announcement {
  id        String    @id @default(cuid())
  text      String // may use copy variables, such as {envio_gratis_desde}
  href      String?
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  position  Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("announcements")
}

// Pre-launch list (GEN-08).
model WaitlistSignup {
  id          String    @id @default(cuid())
  email       String    @unique
  consentText String    @map("consent_text")
  createdAt   DateTime  @default(now()) @map("created_at")
  exportedAt  DateTime? @map("exported_at")

  @@map("waitlist_signups")
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  consentText    String    @map("consent_text")
  source         String // footer, checkout, ...
  createdAt      DateTime  @default(now()) @map("created_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")

  @@map("newsletter_subscribers")
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

// Contact form (CMS-03). Attachments are private media keys.
model ContactMessage {
  id          String        @id @default(cuid())
  reason      String
  name        String
  email       String
  phone       String?
  orderNumber String?       @map("order_number")
  message     String
  attachments String[]
  status      ContactStatus @default(NEW)
  note        String? // internal
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("contact_messages")
}

enum MediaVisibility {
  PUBLIC // catalog and content images, served at /media/<key>
  PRIVATE // contact attachments and other personal files: admin only
}

// Files in storage (src/server/storage). Product images reference `fileName`,
// the name used in the catalog template's `imagenes` column.
model MediaAsset {
  id         String          @id @default(cuid())
  key        String          @unique
  visibility MediaVisibility
  fileName   String          @map("file_name")
  mimeType   String          @map("mime_type")
  size       Int
  width      Int?
  height     Int?
  alt        String?
  createdBy  String?         @map("created_by")
  createdAt  DateTime        @default(now()) @map("created_at")
  deletedAt  DateTime?       @map("deleted_at")

  @@index([fileName])
  @@map("media_assets")
}

// ============================================================================
// Commerce (H2): customers, carts, coupons, orders, payments, stock,
// shipping, refunds, withdrawals, back-in-stock, reviews, emails.
// docs: 03-data-model §1.3, §2 "Pricing and checkout"; 06 Phase 2.
// ============================================================================

// CTA-01..03. A customer account; guests buy without one (CMP-03) and can
// create it later with only a password (IR-12).
model Customer {
  id           String    @id @default(cuid())
  email        String    @unique // lower case
  passwordHash String?   @map("password_hash") // null: no password yet
  firstName    String?   @map("first_name")
  lastName     String?   @map("last_name")
  dni          String?
  phone        String?
  newsletter   Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")

  sessions  CustomerSession[]
  tokens    CustomerToken[]
  addresses Address[]
  favorites Favorite[]
  carts     Cart[]
  orders    Order[]
  reviews   Review[]

  @@map("customers")
}

// Same scheme as admin sessions: the cookie holds a random token, the table its SHA-256.
model CustomerSession {
  id         String   @id // sha256(token)
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@map("customer_sessions")
}

enum CustomerTokenPurpose {
  RESET_PASSWORD
}

model CustomerToken {
  id         String               @id // sha256(token)
  customerId String               @map("customer_id")
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  purpose    CustomerTokenPurpose
  expiresAt  DateTime             @map("expires_at")
  usedAt     DateTime?            @map("used_at")
  createdAt  DateTime             @default(now()) @map("created_at")

  @@index([customerId])
  @@map("customer_tokens")
}

// CMP-03: an Argentine address.
model Address {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  dni        String
  phone      String
  street     String // street and number
  unit       String? // piso y depto
  postcode   String
  locality   String
  province   String // code from src/lib/argentina.ts
  notes      String?
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@map("addresses")
}

// PDP-09.
model Favorite {
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([customerId, productId])
  @@map("favorites")
}

// ---------------------------------------------------------------- cart ----

// CMP-01: persistent across sessions (cookie token), linked to the account at
// login. The email is kept only once the customer leaves it at checkout (EML-04).
model Cart {
  id                   String     @id @default(cuid())
  token                String     @unique // sha256 of the cookie value
  customerId           String?    @map("customer_id")
  customer             Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email                String?
  couponCode           String?    @map("coupon_code")
  ambassadorCode       String?    @map("ambassador_code") // H3 (EMB-02)
  postcode             String? // last shipping quote
  abandonedEmailSentAt DateTime?  @map("abandoned_email_sent_at")
  convertedAt          DateTime?  @map("converted_at") // an order was placed from it
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")
  items                CartItem[]

  @@index([customerId])
  @@index([updatedAt])
  @@map("carts")
}

// Where an item came from (CMP-01: analytics and attribution).
enum ItemSource {
  PDP
  LISTING
  ROUTINE
  DIAGNOSIS
  WHATSAPP
  AMBASSADOR
  SEARCH
  OTHER
}

model CartItem {
  id           String         @id @default(cuid())
  cartId       String         @map("cart_id")
  cart         Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId    String         @map("variant_id")
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity     Int
  source       ItemSource     @default(OTHER)
  sourceRef    String?        @map("source_ref") // routine code, diagnosis id
  routineGroup String?        @map("routine_group") // items added as one routine (BO-03); discount in H3
  addedAt      DateTime       @default(now()) @map("added_at")

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ------------------------------------------------------------- coupons ----

enum CouponKind {
  PERCENT
  AMOUNT
}

// CMP-08.
model Coupon {
  id                   String             @id @default(cuid())
  code                 String             @unique // upper case
  kind                 CouponKind
  value                Int // percent (1-100) or centavos
  description          String?
  startsAt             DateTime?          @map("starts_at")
  endsAt               DateTime?          @map("ends_at")
  minSubtotalCents     Int?               @map("min_subtotal_cents")
  maxUses              Int?               @map("max_uses")
  firstPurchaseOnly    Boolean            @default(false) @map("first_purchase_only") // by email or DNI
  combinesWithTransfer Boolean            @default(true) @map("combines_with_transfer")
  active               Boolean            @default(true)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  deletedAt            DateTime?          @map("deleted_at")
  redemptions          CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String   @map("coupon_id")
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  orderId   String   @unique @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  email     String
  dni       String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([couponId])
  @@map("coupon_redemptions")
}

// -------------------------------------------------------------- orders ----

// PED-01. Refunds leave their own status (partial or total).
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  MERCADOPAGO
  TRANSFER
}

// Prices, discounts and addresses are snapshots: an order never recomputes
// from the catalog. Discounts follow the cascade of CMP-02 (routine or code,
// the larger; then transfer), capped; each line carries its share so
// commissions and refunds can work per line (X-03).
model Order {
  id            String        @id @default(cuid())
  number        String        @unique // LR-000142
  customerId    String?       @map("customer_id")
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cartId        String?       @map("cart_id")
  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod PaymentMethod @map("payment_method")

  email           String
  firstName       String  @map("first_name")
  lastName        String  @map("last_name")
  dni             String
  phone           String
  shippingAddress Json    @map("shipping_address") // { street, unit, postcode, locality, province, notes }
  invoice         Json? // Factura A: { cuit, businessName } (CK-10)
  newsletterOptIn Boolean @default(false) @map("newsletter_opt_in")

  subtotalCents         Int     @map("subtotal_cents") // charged prices × quantities
  routineDiscountCents  Int     @default(0) @map("routine_discount_cents")
  codeDiscountCents     Int     @default(0) @map("code_discount_cents")
  transferDiscountCents Int     @default(0) @map("transfer_discount_cents")
  discountCents         Int     @default(0) @map("discount_cents") // all of the above, after the cap
  shippingCents         Int     @default(0) @map("shipping_cents")
  totalCents            Int     @map("total_cents")
  couponCode            String? @map("coupon_code")
  ambassadorCode        String? @map("ambassador_code")
  shipping              Json // the chosen quote
  termsAccepted         Json    @map("terms_accepted") // [{ code, version }] (CMP-06)

  reservedUntil       DateTime? @map("reserved_until") // unpaid orders release stock after this
  reminderSentAt      DateTime? @map("reminder_sent_at")
  placedAt            DateTime  @default(now()) @map("placed_at")
  paidAt              DateTime? @map("paid_at")
  preparingAt         DateTime? @map("preparing_at")
  shippedAt           DateTime? @map("shipped_at")
  deliveredAt         DateTime? @map("delivered_at")
  cancelledAt         DateTime? @map("cancelled_at")
  refundedAt          DateTime? @map("refunded_at")
  reviewRequestSentAt DateTime? @map("review_request_sent_at")
  anonymizedAt        DateTime? @map("anonymized_at") // CTA-03
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  items        OrderItem[]
  events       OrderEvent[]
  payments     Payment[]
  reservations StockReservation[]
  shipment     Shipment?
  refunds      Refund[]
  redemption   CouponRedemption?
  withdrawals  WithdrawalRequest[]

  @@index([status, placedAt])
  @@index([email])
  @@index([customerId, placedAt])
  @@index([status, reservedUntil])
  @@map("orders")
}

model OrderItem {
  id               String          @id @default(cuid())
  orderId          String          @map("order_id")
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId        String?         @map("variant_id")
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productId        String?         @map("product_id")
  productCode      String          @map("product_code")
  productName      String          @map("product_name")
  brandName        String          @map("brand_name")
  sku              String
  sizeLabel        String          @map("size_label")
  image            String? // file name in the media library
  quantity         Int
  unitPriceCents   Int             @map("unit_price_cents") // list price
  unitChargedCents Int             @map("unit_charged_cents") // promo or list
  subtotalCents    Int             @map("subtotal_cents") // charged × quantity
  discountCents    Int             @default(0) @map("discount_cents") // this line's share
  totalCents       Int             @map("total_cents") // subtotal − discount: commission base, no shipping
  unitCostCents    Int?            @map("unit_cost_cents") // admin only (CAT-20)
  source           ItemSource      @default(OTHER)
  sourceRef        String?         @map("source_ref")
  routineGroup     String?         @map("routine_group")
  refundedQuantity Int             @default(0) @map("refunded_quantity")
  reviews          Review[]

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

enum ActorType {
  SYSTEM
  ADMIN
  CUSTOMER
  PROVIDER
}

// PED-01: append-only; every change of state, payment or shipment, with its author.
model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String       @map("order_id")
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String // status, payment, shipment, refund, note, withdrawal
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus? @map("to_status")
  message    String?
  data       Json?
  actorType  ActorType    @map("actor_type")
  actorId    String?      @map("actor_id")
  actorLabel String?      @map("actor_label") // admin email, "Mercado Pago", ...
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_events")
}

// ------------------------------------------------------------- payments ----

// One row per payment attempt: Mercado Pago can try several times on one
// order. For transfers, one row holds the receipt and its review. Card data
// never reach this table (CMP-07).
model Payment {
  id           String    @id @default(cuid())
  orderId      String    @map("order_id")
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider     String // mercadopago | transfer | simulator
  externalId   String?   @unique @map("external_id") // provider payment id
  preferenceId String?   @map("preference_id")
  status       String // approved | pending | in_process | rejected | cancelled | refunded | charged_back | awaiting_transfer | receipt_uploaded
  statusDetail String?   @map("status_detail")
  method       String? // credit_card, debit_card, account_money, ticket, bank_transfer
  installments Int?
  amountCents  Int       @map("amount_cents")
  receipt      String? // private media key of the transfer receipt
  receiptAt    DateTime? @map("receipt_at")
  reviewedBy   String?   @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at")
  raw          Json? // provider response as read from its API
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("payments")
}

// CMP-04: every notification is stored once by its key, so a replay is a no-op.
model PaymentNotification {
  id          String    @id @default(cuid())
  provider    String
  dedupeKey   String    @unique @map("dedupe_key")
  resourceId  String?   @map("resource_id")
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")
  error       String?

  @@map("payment_notifications")
}

// ---------------------------------------------------------------- stock ----

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
}

// PED-02: stock is taken from the variant when the payment starts (an atomic
// conditional update, so two buyers never take the last unit) and given back
// if the order is not paid in time. A kit reserves its own SKU (D-06).
model StockReservation {
  id         String            @id @default(cuid())
  orderId    String            @map("order_id")
  order      Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId  String            @map("variant_id")
  variant    ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity   Int
  status     ReservationStatus @default(ACTIVE)
  createdAt  DateTime          @default(now()) @map("created_at")
  resolvedAt DateTime?         @map("resolved_at")

  @@unique([orderId, variantId])
  @@map("stock_reservations")
}

enum MovementType {
  RESERVATION // − at payment start
  RELEASE // + an unpaid order expired or was cancelled
  RETURN // + refunded items put back
  ADJUSTMENT // ± from the panel
}

// The stock ledger: every change to ProductVariant.stock outside the import.
model InventoryMovement {
  id         String         @id @default(cuid())
  variantId  String         @map("variant_id")
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type       MovementType
  quantity   Int // signed
  stockAfter Int            @map("stock_after")
  orderId    String?        @map("order_id")
  note       String?
  actor      String? // admin email or "sistema"
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([variantId, createdAt])
  @@map("inventory_movements")
}

// ------------------------------------------------------------- shipping ----

// ENV-04: the standard boxes; an order ships in the smallest that fits.
model ShippingBox {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  heightCm         Decimal  @map("height_cm") @db.Decimal(6, 1)
  widthCm          Decimal  @map("width_cm") @db.Decimal(6, 1)
  lengthCm         Decimal  @map("length_cm") @db.Decimal(6, 1)
  emptyWeightGrams Int      @default(0) @map("empty_weight_grams")
  maxWeightGrams   Int?     @map("max_weight_grams")
  isDefault        Boolean  @default(false) @map("is_default") // products without measurements (CAT-11)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("shipping_boxes")
}

// ENV-03: when the provider's API does not answer, these rates quote instead.
// A zone is a set of provinces; the first active zone holding the province
// wins (by position).
model ShippingRate {
  id         String   @id @default(cuid())
  zone       String
  provinces  String[] // province codes
  carrier    String // what the customer sees
  priceCents Int      @map("price_cents")
  minDays    Int      @map("min_days")
  maxDays    Int      @map("max_days")
  position   Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("shipping_rates")
}

enum ShipmentStatus {
  PENDING // waiting to be created at the provider
  CREATED // label ready
  DISPATCHED
  DELIVERED
  FAILED
  CANCELLED
}

// ENV-01, ENV-05: created at the provider when the order is paid; what the
// API does not cover (tracking, delivered) is set from the panel.
model Shipment {
  id           String         @id @default(cuid())
  orderId      String         @unique @map("order_id")
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider     String // zipnova | manual
  status       ShipmentStatus @default(PENDING)
  carrier      String?
  service      String?
  externalId   String?        @map("external_id")
  trackingCode String?        @map("tracking_code")
  trackingUrl  String?        @map("tracking_url")
  label        String? // private media key of the label
  boxCode      String?        @map("box_code")
  weightGrams  Int?           @map("weight_grams")
  costCents    Int?           @map("cost_cents") // what the provider charges LaRutina
  error        String?
  raw          Json?
  dispatchedAt DateTime?      @map("dispatched_at")
  deliveredAt  DateTime?      @map("delivered_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@map("shipments")
}

// -------------------------------------------------------------- refunds ----

// PED-03: partial or total; items optionally back in stock. Each refund fires
// the commission hook (X-03; commissions arrive in H3).
model Refund {
  id               String   @id @default(cuid())
  orderId          String   @map("order_id")
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountCents      Int      @map("amount_cents")
  total            Boolean // the whole remaining amount
  reason           String
  items            Json // [{ orderItemId, quantity, restock }]
  providerRefundId String?  @map("provider_refund_id")
  createdBy        String   @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("refunds")
}

// ---------------------------------------------- withdrawal, stock alerts ----

// PED-04 (Res. SCI 424/2020): no account needed; the code is emailed at once.
model WithdrawalRequest {
  id          String    @id @default(cuid())
  code        String    @unique // ARR-XXXXXX
  orderId     String?   @map("order_id")
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderNumber String    @map("order_number")
  name        String
  email       String
  phone       String?
  dni         String?
  reason      String?
  status      String    @default("received") // received | in_progress | closed
  note        String? // internal
  emailSentAt DateTime? @map("email_sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("withdrawal_requests")
}

// NAV-07: one notice per request, sent once when stock goes from 0 to more.
model BackInStockRequest {
  id         String         @id @default(cuid())
  email      String
  variantId  String         @map("variant_id")
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now()) @map("created_at")
  notifiedAt DateTime?      @map("notified_at")

  @@index([variantId, notifiedAt])
  @@index([email])
  @@map("back_in_stock_requests")
}

// -------------------------------------------------------------- reviews ----

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// PDP-07: only from verified buyers (one per purchased line), moderated
// before publishing. The block shows from a configurable minimum.
model Review {
  id          String       @id @default(cuid())
  productId   String       @map("product_id")
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItemId String       @unique @map("order_item_id")
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  customerId  String?      @map("customer_id")
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  authorName  String       @map("author_name") // first name and initial
  rating      Int // 1–5
  title       String?
  body        String
  status      ReviewStatus @default(PENDING)
  moderatedBy String?      @map("moderated_by")
  moderatedAt DateTime?    @map("moderated_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([productId, status])
  @@map("reviews")
}

// ---------------------------------------------------------------- email ----

// EML-01: a row only once the text of an email is changed in the panel; the
// defaults live in code (src/server/email/templates.ts), from the content file.
model EmailTemplate {
  key       String   @id
  subject   String
  preheader String   @default("")
  body      String // Markdown subset with {variables}
  ctaLabel  String   @default("") @map("cta_label")
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED // no provider configured: kept in the log only
}

// Outbox and log at once: emails are written here in the same transaction as
// the change that causes them, and the sweep sends them. The dedupe key makes
// each transactional email go out once (EML-02).
model EmailMessage {
  id          String      @id @default(cuid())
  template    String
  dedupeKey   String?     @unique @map("dedupe_key")
  to          String
  subject     String
  html        String
  text        String
  status      EmailStatus @default(QUEUED)
  attempts    Int         @default(0)
  lastError   String?     @map("last_error")
  providerId  String?     @map("provider_id")
  relatedType String?     @map("related_type") // order, customer, withdrawal
  relatedId   String?     @map("related_id")
  sendAfter   DateTime    @default(now()) @map("send_after")
  sentAt      DateTime?   @map("sent_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([status, sendAfter])
  @@index([relatedType, relatedId])
  @@map("email_messages")
}
