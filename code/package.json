{
  "name": "larutina",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "routines": "tsx tests/unit/print-routines.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "catalog:import": "tsx --env-file=.env scripts/catalog-import.ts",
    "admin": "tsx --env-file-if-exists=.env scripts/admin.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "aws4fetch": "1.0.20",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "next": "16.3.6",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "17.11.0-beta.19",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@17.11.0-beta.19": true,
    "@embedded-postgres/windows-x64@17.11.0-beta.19": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
