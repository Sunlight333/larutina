# PostgreSQL. Locally: `npm run db:dev` runs one on this URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/larutina"

# Optional. Absolute URL used for Open Graph images and metadata.
# NEXT_PUBLIC_SITE_URL="https://larutinabeauty.com"

# Only for regenerating images (npm run images:generate). Not needed to run the app.
# REPLICATE_API_TOKEN=""
