# ---------- code/ (the Next.js app) ----------
# dependencies
/code/node_modules

# next.js
/code/.next/
/code/out/
/code/next-env.d.ts
*.tsbuildinfo

# env files — never commit credentials
.env
.env*.local

# local tooling
/code/.pgdata/
/code/storage/
/code/.vercel
npm-debug.log*
.DS_Store

# raw image generations live outside the repo; only processed files in code/public/ are committed
/code/images-raw/

# ---------- docs/ ----------
# The repository is public. Client documents, proposals and inputs stay local;
# only the README index files are committed.
/docs/**
!/docs/**/
!/docs/**/README.md
